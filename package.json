{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test": "vitest run",
        "typecheck": "vue-tsc --noEmit",
        "lint": "eslint resources/js *.js",
        "format": "prettier --write resources/js *.js",
        "format:check": "prettier --check resources/js *.js"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "@vue/test-utils": "^2.5.1",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.12.0",
        "globals": "^17.14.0",
        "jsdom": "^29.1.1",
        "laravel-vite-plugin": "^2.0.0",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^7.0.7",
        "vitest": "^5.1.0",
        "vue-tsc": "^3.3.14"
    },
    "dependencies": {
        "@vitejs/plugin-vue": "^6.0.10",
        "vue": "^3.5.44"
    }
}
